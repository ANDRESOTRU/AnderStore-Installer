{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnderStore Installer",
  "version": "2.3.7",
  "identifier": "uk.andresot.anderstore.installer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AnderStore Installer",
        "width": 800,
        "height": 600,
        "minHeight": 300,
        "minWidth": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0QUFBMkYxRTQ1MUQxMgpSV1FTSFVVZUw2cEtEMUFXYUVqb2VuVnRhRC9RMU96akZyTGR5MXNXOWN0cGRpZU1EYmltYWRDQwo=",
      "endpoints": [
        "https://github.com/ANDRESOTRU/AnderStore-Installer/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
